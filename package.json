{
  "name": "handball-threejs-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test --project=functional",
    "capture": "playwright test --project=capture",
    "profile": "npm run profile:balanced",
    "profile:balanced": "DEMO_PROFILE_PRESET=balanced playwright test --project=profile",
    "profile:high": "DEMO_PROFILE_PRESET=high playwright test --project=profile",
    "profile:capture": "DEMO_PROFILE_PRESET=capture playwright test --project=profile",
    "profile:all": "npm run profile:balanced && npm run profile:high && npm run profile:capture",
    "asset:audit": "bash tools/asset-audit.sh",
    "validate:static": "npm run typecheck && npm test && npm run build && npm run asset:audit",
    "validate:browser": "npm run test:e2e && npm run capture && npm run profile:all",
    "validate": "npm run validate:static && npm run validate:browser",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
